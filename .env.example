# .env.example
#
# Template for the credentials this project needs.
# Copy it to .env and fill in your own values:
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Mac / Linux)
#
# .env is excluded by .gitignore and must never be committed.
# This file must only ever contain placeholders.


# --- REQUIRED ---
# OddsPapi is the production data source for every bot in this project.
# Free key from https://oddspapi.io
ODDSPAPI_API_KEY=your_key_here


# --- OPTIONAL ---
# Betfair's direct API. Used only by the reference scripts in scripts/
# (test_betfair.py, test_betfair_odds.py) for cross-checking aggregator
# prices. The bots themselves reach Betfair through OddsPapi, so these
# are not needed to run anything in scripts/2up_bot/.
#
# The direct API also requires a self-signed certificate pair in certs/,
# generated by generate_certs.py and uploaded to your Betfair account.
BETFAIR_API_KEY=your_key_here
BETFAIR_USERNAME=your_username_here
BETFAIR_PASSWORD=your_password_here


# Kalshi and Polymarket need no credentials - both expose public
# read-only APIs, so no variables are required for them.
#
# Smarkets will need a key here once direct API access is purchased.